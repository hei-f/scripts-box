{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scripts-box",
  "version": "0.2.0",
  "identifier": "io.github.hei-f.scripts-box",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scripts Box",
        "width": 800,
        "height": 600
      },
      {
        "label": "quick-execution",
        "title": "快速执行",
        "url": "index.html#/?window=quick-execution",
        "width": 600,
        "height": 400,
        "visible": false,
        "decorations": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "id": "main"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
